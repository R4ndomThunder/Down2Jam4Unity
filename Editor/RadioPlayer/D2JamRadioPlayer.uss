.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(68, 138, 255);
}

.unity-progress-bar__progress {
    background-color: rgb(62, 66, 152);
}

.unity-progress-bar__background {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(26, 28, 75);
    border-right-color: rgb(26, 28, 75);
    border-top-color: rgb(26, 28, 75);
    border-bottom-color: rgb(26, 28, 75);
    overflow: hidden;
}

.unity-progress-bar__title {
    color: rgb(255, 255, 255);
}

.unity-base-slider__fill {
    background-color: rgb(62, 66, 152);
}

.unity-base-slider__dragger {
    background-color: rgb(62, 66, 152);
    border-left-color: rgb(26, 28, 75);
    border-right-color: rgb(26, 28, 75);
    border-top-color: rgb(26, 28, 75);
    border-bottom-color: rgb(26, 28, 75);
}

.unity-base-slider__label {
    min-width: 50px;
}
